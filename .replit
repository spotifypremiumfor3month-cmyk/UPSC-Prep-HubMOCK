modules = ["nodejs-24", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
VITE_FIREBASE_APP_ID = "1:666270683122:web:68ac8ae268b57fcf19256b"
VITE_FIREBASE_AUTH_DOMAIN = "upsclogin-1474f.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID = "upsclogin-1474f"
